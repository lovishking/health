# Application Configuration
PROJECT_NAME="Real-Time Healthcare Decision Support System (RT-HDSS)"
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production-demo-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default to SQLite for zero-config fast local setup:
DATABASE_URL=sqlite:///./rthdss.db
# For PostgreSQL (Docker / local service):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rthdss

# Redis Buffer Configuration (Optional in local dev)
REDIS_ENABLED=False
REDIS_URL=redis://localhost:6379/0

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Notification Worker & Twilio (Optional - mock provider will be used if empty)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=

# ML Model Configuration
XGBOOST_MODEL_PATH=ml/models/xgboost_static_v1.json
LSTM_MODEL_PATH=ml/models/lstm_temporal_v1.pt
HYBRID_ALPHA=0.5
